{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/ppl", "destination": "/src/pages/ppl.html" },
    { "source": "/deld", "destination": "/src/pages/deld.html" },
    { "source": "/os", "destination": "/src/pages/os.html" }
  ],
  "headers": [
    {
      "source": "/src/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
